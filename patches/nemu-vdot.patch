diff --git a/src/isa/riscv64/instr/rvv/vcompute.h b/src/isa/riscv64/instr/rvv/vcompute.h
index 2bcb6aae..d5be592f 100644
--- a/src/isa/riscv64/instr/rvv/vcompute.h
+++ b/src/isa/riscv64/instr/rvv/vcompute.h
@@ -19,6 +19,37 @@
 #include "vcompute_impl.h"
 #include "vcommon.h"
 
+def_EHelper(vdot) {
+  require_vector(true);
+  if (!s->vm || vtype->vsew != 0 || vtype->vlmul == 4) {
+    longjmp_exception(EX_II);
+  }
+  check_vstart_exception(s);
+
+  // Both sources are LMUL groups; the destination is one vector register.
+  unsigned group_regs = vtype->vlmul < 4 ? 1u << vtype->vlmul : 1;
+  require_aligned(id_src1->reg, group_regs);
+  require_aligned(id_src2->reg, group_regs);
+
+  if (vl->val != 0) {
+    // Read the complete source groups before writing an overlapping destination.
+    int32_t sum = 0;
+    for (word_t i = 0; i < vl->val; ++i) {
+      rtlreg_t a, b;
+      get_vreg(id_src1->reg, i, &a, 0, vtype->vlmul, 0, 0);
+      get_vreg(id_src2->reg, i, &b, 0, vtype->vlmul, 0, 0);
+      sum += (int32_t)(int8_t)a * (int32_t)(int8_t)b;
+    }
+    // Ignore vta/vma: the custom instruction clears every bit above bit 31.
+    for (int i = 0; i < VENUM32; ++i) {
+      set_vreg(id_dest->reg, i, i == 0 ? (uint32_t)sum : 0, 2, 0, 1);
+    }
+  }
+  rtl_li(s, s0, 0);
+  vcsr_write(IDXVSTART, s0);
+  vp_set_dirty();
+}
+
 def_EHelper(vadd) {
   ARITH(ADD, SIGNED)
 }
